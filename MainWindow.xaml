<Window x:Class="MiniPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiniPos.Converters"
        Title="{Binding Title}" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <c:PriceToColorConverter x:Key="PriceColorConv"/>
    </Window.Resources>
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!--[Row 0, Col 0~1] 상단 헤더 바 -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#2C3E50" Padding="20,0">
            <TextBlock Text="{Binding Title}"
                       Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- [Row 1~2, Col 0] 좌측: 상품 목록 패널 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                Margin="15" Background="White" CornerRadius="8"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style x:Key="FilterButtonStyle" TargetType="RadioButton">
                        <Setter Property="Margin" Value="0, 0, 10, 0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="#EDF2F7" CornerRadius="15" Padding="16,8" Cursor="Hand">
                                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontWeight="Bold" Foreground="#4A5568"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3182CE"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!-- 영역 타이틀 -->
                <TextBlock Grid.Row="0" Text="📦 상품 선택 (클릭하여 주문)"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#34495E"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton Content="전체" Style="{StaticResource FilterButtonStyle}"
                                 IsChecked="True"
                                 Command="{Binding SetCategoryFilterCommand}" CommandParameter="All"/>
                    <RadioButton Content="☕ Coffee" Style="{StaticResource FilterButtonStyle}" 
                         Command="{Binding SetCategoryFilterCommand}" CommandParameter="Coffee"/>

                    <RadioButton Content="🍰 Dessert" Style="{StaticResource FilterButtonStyle}" 
                         Command="{Binding SetCategoryFilterCommand}" CommandParameter="Dessert"/>
                </StackPanel>

                    <!-- 상품 목록을 출력하는 ListBox -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding ProductsView}"
                         SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                         HorizontalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent" Padding="5">

                    <!-- ★ 1. 그리드 형태의 레이아웃 배치 (2열 바둑판 배열) -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ★ 2. 컨테이너 스타일 (선택/호버 시 배경 및 테두리 효과 제거/수정) -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- ★ 3. 데이터 템플릿 (개별 상품 카드 UI 정의) -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 상품 카드 외벽 (Border) -->
                            <Border x:Name="CardBorder"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="14"
                                    Cursor="Hand">
                                <!-- 그림자 효과 추가 -->
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="8" ShadowDepth="2"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <!--카테고리-->
                                        <RowDefinition Height="Auto"/>
                                        <!--상품명-->
                                        <RowDefinition Height="Auto"/>
                                        <!--가격-->
                                    </Grid.RowDefinitions>

                                    <!-- ① 카테고리 뱃지 (좌측 상단) -->
                                    <!-- 카테고리에 따라 색상이 변하는 트리거는 아래 DataTemplate.Triggers에서 구현 -->
                                    <Border x:Name="BadgeBorder"
                                        Grid.Row="0" 
                                        Background="#EBF4FF" 
                                        CornerRadius="6" 
                                        Padding="8,3" 
                                        HorizontalAlignment="Left" 
                                        Margin="0,0,0,10">
                                        <TextBlock x:Name="BadgeText"
                                           Text="{Binding Category}" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="#3182CE"/>
                                    </Border>

                                    <!-- ② 상품명 바인딩 -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold" 
                                               Foreground="#2D3748" 
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- ③ 단가 바인딩 (통화 포맷팅 적용) -->
                                    <!--<TextBlock Grid.Row="2" 
                                               Text="{Binding Price, StringFormat={}{0:N0}원}" 
                                               FontSize="18" 
                                               FontWeight="Heavy" 
                                               Foreground="#E53E3E" 
                                               HorizontalAlignment="Right"/>-->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Price, StringFormat={}{0:N0}원}"
                                               FontSize="18"
                                               FontWeight="Heavy"
                                               Foreground="{Binding Price, Converter={StaticResource PriceColorConv}}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <!-- ★ 4. 데이터 및 마우스 상태에 따른 동적 속성 변경 (Triggers) -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Dessert">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#FFF5F5"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#E53E3E"/>
                                </DataTrigger>
                                <!-- 데이터의 Category 값이 "Coffee"면 뱃지를 브라운빛으로 변경 -->
                                <DataTrigger Binding="{Binding Category}" Value="Coffee">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#FEFCBF"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#744210"/>
                                </DataTrigger>

                                <!-- 마우스가 카드 위에 올라갔을 때 (Hover) 테두리와 색상 변경 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3182CE"/>
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F7FAFC"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button
                    Grid.Row="3"
                    Content="상품 추가" 
                    Command="{Binding AddProductCommand}"
                    Padding="1,1" Background="#3182CE" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Right"
                />
            </Grid>
        </Border>

        <!-- [Row 1, Col 1] 우측 상단: 실시간 로그 & REST API 통합 패널 -->
        <Border Grid.Row="1" Grid.Column="1" 
        Margin="0,15,15,7.5" Background="White" CornerRadius="8" Padding="10">

            <!-- ★ 핵심: TabControl을 사용하여 2개의 화면을 탭으로 분리합니다! -->
            <TabControl BorderThickness="0" Background="Transparent">

                <!-- ======================================================= -->
                <!-- [탭 1] 기존의 실시간 결제 로그 -->
                <!-- ======================================================= -->
                <TabItem Header="📝 실시간 결제 로그" FontSize="15" FontWeight="SemiBold" Padding="12,6">
                    <Grid Margin="0,10,0,0">
                        <!-- 기존에 바인딩했던 OrderLogs 리스트 -->
                        <ListBox ItemsSource="{Binding OrderLogs}" 
                         BorderThickness="1" BorderBrush="#E2E8F0" 
                         Background="#FAFAFA" FontSize="14" Padding="10">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- ======================================================= -->
                <!-- [탭 2] 새로 만든 REST API 수신 데이터 -->
                <!-- ======================================================= -->
                <TabItem Header="🌐 REST API 데이터" FontSize="15" FontWeight="SemiBold" Padding="12,6">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 상단: API 호출 버튼 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="jsonplaceholder.typicode.com/posts" 
                               FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>

                            <Button Content="📥 API 호출 (GET)" 
                            Command="{Binding FetchApiDataCommand}"
                            Padding="12,6" Background="#3182CE" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- 하단: API 게시물 카드 리스트 -->
                        <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ApiPosts}" 
                         BorderThickness="1" BorderBrush="#E2E8F0" Background="#FAFAFA" Padding="5">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <Border Background="#ED8936" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Id, StringFormat={}POST #{0}}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding UserId, StringFormat={}User ID: {0}}" FontSize="12" Foreground="#718096" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <!-- 게시물 제목 -->
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#2D3748" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            <!-- 게시물 본문 (LineHeight & MaxHeight로 2줄 제한 보정 완료) -->
                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#4A5568" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="16" MaxHeight="32"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>


        <!-- [Row 2, Col 1] 우측 하단: 총 결제 금액 및 버튼 제어 패널 -->
        <Border Grid.Row="2" Grid.Column="1"
                Margin="0, 7.5, 15, 15" Background="White" CornerRadius="8"
                Padding="15">
            <StackPanel>
                <!-- 총 결제 금액 표시 영역 -->
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="총 결제 금액:" FontSize="18" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C0}원}" 
                               FontSize="26" FontWeight="Heavy" Foreground="#E74C3C" 
                               HorizontalAlignment="Right" TextAlignment="Right"/>
                </DockPanel>

                <!-- 제어 버튼 2개 배치 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{Binding SimulationButtonText}"
                            Command="{Binding ToggleSimulationCommand}"
                            Height="45"
                            Background="#2980B9"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- 임시 테스트: 첫 번째 상품(아메리카노)을 주문에 추가하는 버튼 -->
                    <!--<Button Grid.Column="0" Content="☕ 1번 상품 주문 테스트" 
                            Command="{Binding AddOrderCommand}"
                            CommandParameter="{Binding Products[0]}"
                            Height="45" Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"/>-->

                    <!-- 주문 초기화 버튼 -->
                    <Button Grid.Column="2" Content="🗑️ 주문 내역 초기화" 
                            Command="{Binding ClearOrderCommand}"
                            Height="45" Background="#E74C3C" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"/>

                </Grid>
                <Border Margin="0,15,0,0" Padding="12" Background="#EDF2F7" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="⚡ 실시간 TCP 소켓 결제 통신 테스트" FontSize="13" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. 내장 TCP 서버 켜기/끄기 버튼 -->
                            <Button Grid.Column="0" 
                            Content="{Binding ServerButtonText}" 
                            Command="{Binding ToggleTcpServerCommand}"
                            Height="40" Background="#4A5568" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                            <!-- 2. TCP 결제 승인 요청 (소켓 통신 발송) 버튼 -->
                            <Button Grid.Column="2" 
                            Content="💳 TCP 결제 승인 요청 (Send)" 
                            Command="{Binding RequestTcpPaymentCommand}"
                            Height="40" Background="#805AD5" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="12" Background="#FEFCBF" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🖨️ 포트번호:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#744210"/>

                        <!-- COM 포트 입력 텍스트박스 (예: COM1, COM3, COM10) -->
                        <TextBox Grid.Column="1" Text="{Binding ComPortName, Mode=TwoWay}" 
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                         FontWeight="Bold" FontSize="13" Padding="4"/>

                        <!-- 영수증 출력 실행 버튼 -->
                        <Button Grid.Column="3" 
                        Content="📄 실물 영수증 인쇄 (Serial)" 
                        Command="{Binding PrintReceiptCommand}"
                        Height="40" Background="#D69E2E" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>
                </Border>

            </StackPanel>
            
        </Border>
    </Grid>
</Window>
