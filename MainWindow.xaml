<Window x:Class="MiniPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiniPos.Converters"
        Title="{Binding Title}"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <c:PriceToColorConverter x:Key="PriceColorConv" />
    </Window.Resources>
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--  [Row 0, Col 0~1] 상단 헤더 바  -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="20,0"
                Background="#2C3E50">
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="{Binding Title}" />
        </Border>

        <!--  [Row 1~2, Col 0] 좌측: 상품 목록 패널  -->
        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="0"
                Margin="15"
                Padding="15"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style x:Key="FilterButtonStyle" TargetType="RadioButton">
                        <Setter Property="Margin" Value="0,0,10,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border"
                                            Padding="16,8"
                                            Background="#EDF2F7"
                                            CornerRadius="15"
                                            Cursor="Hand">
                                        <TextBlock x:Name="txt"
                                                   FontWeight="Bold"
                                                   Foreground="#4A5568"
                                                   Text="{TemplateBinding Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#3182CE" />
                                            <Setter TargetName="txt" Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <!--  영역 타이틀  -->
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,10"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#34495E"
                           Text="📦 상품 선택 (클릭하여 주문)" />
                <DockPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Width="auto"
                               FontSize="16"
                               Text="상품 조회 : " />
                    <TextBox FontSize="16" Text="{Binding SearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,15"
                            Orientation="Horizontal">
                    <RadioButton Command="{Binding SetCategoryFilterCommand}"
                                 CommandParameter="All"
                                 Content="전체"
                                 IsChecked="True"
                                 Style="{StaticResource FilterButtonStyle}" />
                    <RadioButton Command="{Binding SetCategoryFilterCommand}"
                                 CommandParameter="Coffee"
                                 Content="☕ Coffee"
                                 Style="{StaticResource FilterButtonStyle}" />
                    <RadioButton Command="{Binding SetCategoryFilterCommand}"
                                 CommandParameter="Dessert"
                                 Content="🍰 Dessert"
                                 Style="{StaticResource FilterButtonStyle}" />
                    <RadioButton Command="{Binding SetCategoryFilterCommand}"
                                 CommandParameter="Beverage"
                                 Content="🍹 Beverage"
                                 Style="{StaticResource FilterButtonStyle}" />
                </StackPanel>

                <!--  상품 목록을 출력하는 ListBox  -->
                <ListBox Grid.Row="3"
                         Padding="5"
                         HorizontalAlignment="Stretch"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding ProductsView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <!--  ★ 1. 그리드 형태의 레이아웃 배치 (2열 바둑판 배열)  -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid VerticalAlignment="Top" Columns="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!--  ★ 2. 컨테이너 스타일 (선택/호버 시 배경 및 테두리 효과 제거/수정)  -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!--  ★ 3. 데이터 템플릿 (개별 상품 카드 UI 정의)  -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--  카드 클릭 = 주문 추가. ListBox 선택 상태에 의존하지 않음  -->
                            <Button HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.AddOrderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <!--  상품 카드 외벽 (Border)  -->
                                <Border x:Name="CardBorder"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Cursor="Hand">
                                    <!--  그림자 효과 추가  -->
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          Opacity="0.05"
                                                          ShadowDepth="2"
                                                          Color="#000000" />
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <!--  카테고리  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  상품명  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  가격  -->
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                            <!--  ① 카테고리 뱃지 (좌측 상단)  -->
                                            <!--  카테고리에 따라 색상이 변하는 트리거는 아래 DataTemplate.Triggers에서 구현  -->
                                            <Border x:Name="BadgeBorder"
                                                    Grid.Row="0"
                                                    Margin="0,0,0,10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    Background="#EBF4FF"
                                                    CornerRadius="6">
                                                <TextBlock x:Name="BadgeText"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#3182CE"
                                                           Text="{Binding Category}" />
                                            </Border>

                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Padding="5,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Content="수정"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#E53E3E" />

                                                <Button Padding="5,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding DataContext.DelProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Content="X"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#E53E3E" />
                                            </StackPanel>

                                        </DockPanel>

                                        <!--  ② 상품명 바인딩  -->
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,0,0,8"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#2D3748"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!--  ③ 단가 바인딩 (통화 포맷팅 적용)  -->
                                        <!--<TextBlock Grid.Row="2"
                                               Text="{Binding Price, StringFormat={}{0:N0}원}"
                                               FontSize="18"
                                               FontWeight="Heavy"
                                               Foreground="#E53E3E"
                                               HorizontalAlignment="Right"/>-->
                                        <TextBlock Grid.Row="2"
                                                   HorizontalAlignment="Right"
                                                   FontSize="18"
                                                   FontWeight="Heavy"
                                                   Foreground="{Binding Price, Converter={StaticResource PriceColorConv}}"
                                                   Text="{Binding Price, StringFormat={}{0:N0}원}" />
                                    </Grid>
                                </Border>
                            </Button>
                            <!--  ★ 4. 데이터 및 마우스 상태에 따른 동적 속성 변경 (Triggers)  -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Dessert">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#FFF5F5" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#E53E3E" />
                                </DataTrigger>
                                <!--  데이터의 Category 값이 "Coffee"면 뱃지를 브라운빛으로 변경  -->
                                <DataTrigger Binding="{Binding Category}" Value="Coffee">
                                    <Setter TargetName="BadgeBorder" Property="Background" Value="#FEFCBF" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="#744210" />
                                </DataTrigger>

                                <!--  마우스가 카드 위에 올라갔을 때 (Hover) 테두리와 색상 변경  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#3182CE" />
                                    <Setter TargetName="CardBorder" Property="Background" Value="#F7FAFC" />
                                </Trigger>

                                <DataTrigger Binding="{Binding Stock}" Value="0">
                                    <Setter TargetName="CardBorder" Property="IsEnabled" Value="False" />
                                    <Setter TargetName="CardBorder" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="CardBorder" Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Padding="1,1"                            
                            Background="#3182CE"
                            BorderThickness="0"
                            Command="{Binding ResetProductCommand}"
                            Content="⚙️ 데이터 초기화"
                            Cursor="Hand"
                            FontWeight="Bold"
                            Foreground="White" 
                            Margin="5,0,5,0"/>
                    <Button Padding="1,1"
                            HorizontalAlignment="Right"
                            Background="#3182CE"
                            BorderThickness="0"
                            Command="{Binding AddProductCommand}"
                            Content="상품 추가"
                            Cursor="Hand"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="5,0,5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  [Row 1, Col 1] 우측 상단: 실시간 로그 & REST API 통합 패널  -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="0,15,15,7.5"
                Padding="10"
                Background="White"
                CornerRadius="8">

            <!--  ★ 핵심: TabControl을 사용하여 2개의 화면을 탭으로 분리합니다!  -->
            <TabControl Background="Transparent" BorderThickness="0">

                <!--  =======================================================  -->
                <!--  [탭 1] 기존의 실시간 결제 로그  -->
                <!--  =======================================================  -->
                <TabItem Padding="12,6"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Header="📝 실시간 결제 로그">
                    <Grid Margin="0,10,0,0">
                        <!--  기존에 바인딩했던 OrderLogs 리스트  -->
                        <ListBox Padding="10"
                                 Background="#FAFAFA"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 FontSize="14"
                                 ItemsSource="{Binding OrderLogs}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!--  =======================================================  -->
                <!--  [탭 2] 새로 만든 REST API 수신 데이터  -->
                <!--  =======================================================  -->
                <TabItem Padding="12,6"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Header="🌐 REST API 데이터">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  상단: API 호출 버튼  -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#718096"
                                       Text="jsonplaceholder.typicode.com/posts" />

                            <Button Padding="12,6"
                                    HorizontalAlignment="Right"
                                    Background="#3182CE"
                                    BorderThickness="0"
                                    Command="{Binding FetchApiDataCommand}"
                                    Content="📥 API 호출 (GET)"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="White" />
                        </DockPanel>

                        <!--  하단: API 게시물 카드 리스트  -->
                        <ListBox Grid.Row="1"
                                 Padding="5"
                                 Background="#FAFAFA"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 ItemsSource="{Binding ApiPosts}">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10"
                                            Background="White"
                                            BorderBrush="#CBD5E0"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <Border Margin="0,0,8,0"
                                                        Padding="6,2"
                                                        Background="#ED8936"
                                                        CornerRadius="4">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding Id, StringFormat={}POST #{0}}" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="#718096"
                                                           Text="{Binding UserId, StringFormat={}User ID: {0}}" />
                                            </DockPanel>

                                            <!--  게시물 제목  -->
                                            <TextBlock Margin="0,0,0,4"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#2D3748"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap" />

                                            <!--  게시물 본문 (LineHeight & MaxHeight로 2줄 제한 보정 완료)  -->
                                            <TextBlock MaxHeight="32"
                                                       FontSize="12"
                                                       Foreground="#4A5568"
                                                       LineHeight="16"
                                                       Text="{Binding Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>


        <!--  [Row 2, Col 1] 우측 하단: 장바구니 및 총 결제 금액 및 버튼 제어 패널  -->
        <Border Grid.Row="2"
                Grid.Column="1"
                Margin="0,7.5,15,15"
                Padding="15"
                Background="White"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         Margin="0,0,0,10"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding CartItems}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Background="#F7FAFC"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!--  상품명  -->
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#2D3748"
                                               Text="{Binding ProductInfo.Name}" />

                                    <!--  수량 증감 조절  -->
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0"
                                                Orientation="Horizontal">
                                        <Button Width="28"
                                                Height="28"
                                                Background="#E2E8F0"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="-"
                                                Cursor="Hand"
                                                FontWeight="Bold" />
                                        <TextBlock Width="35"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="{Binding Quantity}"
                                                   TextAlignment="Center" />
                                        <Button Width="28"
                                                Height="28"
                                                Background="#E2E8F0"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                Cursor="Hand"
                                                FontWeight="Bold" />
                                    </StackPanel>

                                    <!--  단일 항목 소계 (단가 * 수량)  -->
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="#E53E3E"
                                               Text="{Binding SubTotal, StringFormat={}{0:N0}원}"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  회색 분리선  -->
                <Rectangle Grid.Row="1"
                           Height="1"
                           Margin="0,5,0,15"
                           Fill="#E2E8F0" />

                <StackPanel Grid.Row="2">
                    <!--  할인버튼  -->
                    <Button Grid.Column="0"
                            Background="Green"
                            Command="{Binding DiscountCommand}"
                            Content="할인"
                            FontSize="14"
                            Foreground="White" />

                    <DockPanel Margin="0,0,0,5">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#3498DB"
                                   Text="할인금액" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#3498DB"
                                   Text="{Binding DiscountAmount, StringFormat={}-{0:N0}원}" />
                    </DockPanel>

                    <!--  총 결제 금액 표시 영역  -->
                    <DockPanel Margin="0,0,0,15">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Text="총 결제 금액:" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="26"
                                   FontWeight="Heavy"
                                   Foreground="#E74C3C"
                                   Text="{Binding TotalAmount, StringFormat={}{0:C0}, ConverterCulture=ko-KR}"
                                   TextAlignment="Right" />
                    </DockPanel>

                    <!--  제어 버튼 2개 배치  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Height="45"
                                Background="#2980B9"
                                BorderThickness="0"
                                Command="{Binding ToggleSimulationCommand}"
                                Content="{Binding SimulationButtonText}"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White" />

                        <!--  임시 테스트: 첫 번째 상품(아메리카노)을 주문에 추가하는 버튼  -->
                        <!--<Button Grid.Column="0" Content="☕ 1번 상품 주문 테스트"
                                Command="{Binding AddOrderCommand}"
                                CommandParameter="{Binding Products[0]}"
                                Height="45" Background="#27AE60" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"/>-->

                        <!--  주문 초기화 버튼  -->
                        <Button Grid.Column="1"
                                Height="45"
                                Background="#E74C3C"
                                BorderThickness="0"
                                Command="{Binding ClearOrderCommand}"
                                Content="🗑️ 주문 내역 초기화"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White" />

                        <Button Grid.Column="2"
                                Background="AliceBlue"
                                Command="{Binding PaymentCommand}"
                                Content="💸결제완료"
                                FontSize="14"
                                FontWeight="Bold"
                                IsEnabled="{Binding CanPay}" />
                    </Grid>
                    <StackPanel Margin="0,5,0,0">
                        <ProgressBar Height="20"
                                     Foreground="Green"
                                     Maximum="100"
                                     Minimum="0"
                                     Value="{Binding PayProgress}" />
                    </StackPanel>
                    <Border Margin="0,15,0,0"
                            Padding="12"
                            Background="#EDF2F7"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#4A5568"
                                       Text="⚡ 실시간 TCP 소켓 결제 통신 테스트" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!--  1. 내장 TCP 서버 켜기/끄기 버튼  -->
                                <Button Grid.Column="0"
                                        Height="40"
                                        Background="#4A5568"
                                        BorderThickness="0"
                                        Command="{Binding ToggleTcpServerCommand}"
                                        Content="{Binding ServerButtonText}"
                                        Cursor="Hand"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White" />

                                <!--  2. TCP 결제 승인 요청 (소켓 통신 발송) 버튼  -->
                                <Button Grid.Column="2"
                                        Height="40"
                                        Background="#805AD5"
                                        BorderThickness="0"
                                        Command="{Binding RequestTcpPaymentCommand}"
                                        Content="💳 TCP 결제 승인 요청 (Send)"
                                        Cursor="Hand"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#FEFCBF"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#744210"
                                       Text="🖨️ 포트번호:" />

                            <!--  COM 포트 입력 텍스트박스 (예: COM1, COM3, COM10)  -->
                            <TextBox Grid.Column="1"
                                     Padding="4"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     FontWeight="Bold"
                                     Text="{Binding ComPortName, Mode=TwoWay}" />

                            <!--  영수증 출력 실행 버튼  -->
                            <Button Grid.Column="3"
                                    Height="40"
                                    Background="#D69E2E"
                                    BorderThickness="0"
                                    Command="{Binding PrintReceiptCommand}"
                                    Content="📄 실물 영수증 인쇄 (Serial)"
                                    Cursor="Hand"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
