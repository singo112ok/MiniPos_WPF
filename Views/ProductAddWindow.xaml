<Window x:Class="MiniPos.Views.ProductAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 상품 등록" Height="330" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 상품명 입력 (ViewModel의 InputName과 양방향 바인딩) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="상품명:" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,5"/>
            <TextBox Padding="8" FontSize="14" BorderBrush="#CBD5E0"
                     Text="{Binding InputName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- 2. 단가 입력 (ViewModel의 InputPrice와 양방향 바인딩) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="단가 (원):" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,5"/>
            <TextBox Padding="8" FontSize="14" BorderBrush="#CBD5E0"
                     Text="{Binding InputPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- 3. 카테고리 선택 (ViewModel의 Categories 목록 및 SelectedCategory 양방향 바인딩) -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="카테고리:" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,5"/>
            <ComboBox Padding="8" FontSize="14" BorderBrush="#CBD5E0"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
        </StackPanel>

        <!-- 4. 하단 확인/취소 버튼 (이벤트 처리는 코드 비하인드에서 수행) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="80" Height="35" Margin="0,0,10,0" 
                    Background="#E2E8F0" Foreground="#4A5568" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>

            <Button Content="저장" Width="80" Height="35" 
                    Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>