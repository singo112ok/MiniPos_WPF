<Window x:Class="MiniPos.Views.DiscountWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                          
             xmlns:local="clr-namespace:MiniPos.Views"
             Title="할인" Height="250" Width="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0" Text="💸 할인율을 선택하세요" FontSize="18" FontWeight="Bold" 
            Margin="0, 0, 0, 15" Foreground="#2C3E50"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <RadioButton Content="10%" GroupName="Discount" Margin="0, 0, 10, 0" FontSize="16"
                        Command="{Binding SetRateCommand}" CommandParameter="0.1"/>
            <RadioButton Content="20%" GroupName="Discount" Margin="0, 0, 10, 0" FontSize="16"
                        Command="{Binding SetRateCommand}" CommandParameter="0.2"/>
            <RadioButton Content="할인없음" GroupName="Discount" Margin="0, 0, 10, 0" FontSize="16"
                        Command="{Binding SetRateCommand}" CommandParameter="0"/>
        </StackPanel>

        <Button Grid.Row="2" Content="적용하기" Command="{Binding ApplyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Height="40" FontSize="16" Background="#3182CE" Foreground="White"
        />
    </Grid>
</Window>
